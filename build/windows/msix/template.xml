<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Attune"
        Arguments=""
        InstallLocation="C:\Program Files\kevelopment\Attune">
    </Installer>
    <PackageInformation
        PackageName="Attune"
        PackageDisplayName="Attune"
        PublisherName="CN=kevelopment"
        PublisherDisplayName="kevelopment"
        Version="0.0.21.0"
        PackageDescription="Attune your library.">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.kevelopment.attune"
                Description="Attune your library."
                DisplayName="Attune"
                ExecutableName="Attune"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Attune</DisplayName>
            <PublisherDisplayName>kevelopment</PublisherDisplayName>
            <Description>Attune your library.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="attune.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
